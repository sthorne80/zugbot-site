---
import './showcase.css';
interface Props {
  category: string;
  title: string;
  accent: string;
  intro: string;
  link: string;
  action: string;
  secondaryLink: string;
  secondaryAction: string;
}
const {category, title, accent, intro, link, action, secondaryLink, secondaryAction} = Astro.props;
---
<section class="sc-hero" aria-labelledby="showcase-title">
  <div class="wrap sc-hero-grid">
    <div class="sc-intro">
      <p class="kicker"><span class="slashes" aria-hidden="true"></span>{category}</p>
      <h1 id="showcase-title">{title} <em>{accent}</em></h1>
      <p class="sc-deck">{intro}</p>
      <div class="actions">
        <a class="button primary" href={link}>{action}</a>
        <a class="button secondary" href={secondaryLink}>{secondaryAction}</a>
      </div>
    </div>
    <slot />
  </div>
</section>
