---
import { Beer, BookOpen, CalendarDays, Castle, CircleUserRound, ClipboardList, Flag, Gamepad2, LayoutDashboard, LockKeyhole, Megaphone, MessageSquare, Settings2, Shield, Swords, UsersRound } from '@lucide/astro';
import ShowHero from './ShowHero.astro';
import emblem from '../../../docs/assets/zugbot-logo-v2.svg?url';

type Room = {
  name: string;
  icon: typeof CalendarDays;
  title: string;
  rows: [typeof CalendarDays, string, string][];
};
const rooms: Room[] = [
  { name: 'Dashboard', icon: LayoutDashboard, title: 'Guild overview', rows: [
    [CalendarDays, 'Next event', 'Friday raid · 20:00'],
    [UsersRound, 'Open groups', 'Retail Mythic+ · Forever dungeon'],
    [CircleUserRound, 'Your characters', 'Retail and Forever rosters'],
  ] },
  { name: 'Events', icon: CalendarDays, title: 'Guild calendar', rows: [
    [CalendarDays, 'Friday raid', 'Weekly · Retail WoW'],
    [Shield, 'Role signups', 'Tank, Healer, DPS, Bench'],
    [UsersRound, 'Availability', 'Maybe or Can’t Attend'],
  ] },
  { name: 'Groups', icon: UsersRound, title: 'Find your party', rows: [
    [Shield, 'Mythic+ group', 'Retail WoW · role signups'],
    [Castle, 'Dungeon group', 'WoW: Forever · five players'],
    [CircleUserRound, 'Join a group', 'Choose an eligible linked character'],
  ] },
  { name: 'Characters', icon: CircleUserRound, title: 'Character roster', rows: [
    [CircleUserRound, 'Your Mains', 'Set a Main for each game'],
    [Shield, 'Optional verification', 'Confirm ownership with Battle.net'],
    [BookOpen, 'Public lookup', 'Choose a channel to share a result'],
  ] },
  { name: 'Fun', icon: Gamepad2, title: 'Inside the Tavern', rows: [
    [Swords, 'Peon Fight Club', 'Challenge a guildmate to a D20 duel'],
    [Beer, 'Brewfest Keg', 'Ten claims available per keg'],
    [Gamepad2, 'Tavern games', 'Dice, coins, and peon wisdom'],
  ] },
  { name: 'Report an incident', icon: Flag, title: 'Incident reporting', rows: [
    [Flag, 'Guild incident', 'Submit a report for staff review'],
    [LockKeyhole, 'Review access', 'Authorized guild staff'],
  ] },
  { name: 'Leadership', icon: Shield, title: 'Leadership workspace', rows: [
    [UsersRound, 'Directory', 'Review member information'],
    [ClipboardList, 'Casework', 'Read authorized reports and cases'],
    [Megaphone, 'Announcements', 'Coordinate guild communications'],
  ] },
  { name: 'Guild Setup', icon: Settings2, title: 'Guild configuration', rows: [
    [Castle, 'Game modes', 'Choose enabled games and the default'],
    [MessageSquare, 'Channels', 'Configure guild channel mappings'],
    [Shield, 'Authority roles', 'Review protected role changes'],
  ] },
];
---
<div class="showcase sc-command">
  <ShowHero category="Discord Activity" title="Guild command" accent="center" intro="Raid night starts in the Guild Hall. Check the calendar, get a group together, or find your main, all inside your Discord server." link="/get-started/" action="Get started" secondaryLink="/discord-activity/" secondaryAction="Activity guide">
    <figure class="sc-demo cmd-demo">
      <figcaption><strong><Castle aria-hidden="true" />Guild Hall</strong><span class="sc-caption">Illustrative Activity tour</span></figcaption>
      <fieldset class="sc-switch">
        <legend class="sc-sr">Explore an Activity section</legend>
        <div class="cmd-console">
          {rooms.map(({name,icon: Icon,title,rows},i) => (
            <Fragment>
              <input class="sc-option" type="radio" id={`hall-${i}`} name="guild-hall-tour" checked={i === 0} aria-controls={`room-${i}`} />
              <label for={`hall-${i}`} style={`--row:${i + 1}`}><Icon size={16} aria-hidden="true" />{name}</label>
              <div class="sc-pane cmd-room" id={`room-${i}`}>
                <div class="cmd-mast"><div><p class="sc-tag">{name}</p><p class="cmd-title">{title}</p></div><img src={emblem} alt="" width="52" height="52" /></div>
                <ul class="cmd-records">{rows.map(([RowIcon,label,value]) => (
                  <li><RowIcon size={20} aria-hidden="true" /><div><strong>{label}</strong><span>{value}</span></div></li>
                ))}</ul>
              </div>
            </Fragment>
          ))}
        </div>
      </fieldset>
    </figure>
  </ShowHero>
  <section class="sc-section sc-split wrap" aria-labelledby="guild-workspaces">
    <div>
      <p class="kicker"><span class="marker" aria-hidden="true"></span>Inside the Activity</p>
      <h2 id="guild-workspaces">From calendar<br />to guild chat.</h2>
      <p class="sc-description">Launch ZugBot from Discord’s App Launcher in an eligible channel. Members can use their familiar slash commands alongside the graphical Guild Hall.</p>
      <a class="text-link" href="/commands/">Browse the command reference</a>
    </div>
    <ul class="sc-list">
      <li><CalendarDays aria-hidden="true" /><div><h3>Make the plan</h3><p>Move from the Dashboard into Events to review a date, check the roster, and sign up with a character from the event’s game.</p><a class="text-link" href="/guild-planner/">Explore Guild Planner</a></div></li>
      <li><UsersRound aria-hidden="true" /><div><h3>Fill the party</h3><p>Coordinate a Retail Mythic+ run or build a five-person Forever dungeon party. Characters keeps linked rosters and public profile lookup close at hand.</p><a class="text-link" href="/characters-and-groups/">Explore characters and groups</a></div></li>
      <li><Beer aria-hidden="true" /><div><h3>Open the Tavern</h3><p>Tap a Brewfest Keg, roll dice, or challenge a guildmate in Peon Fight Club. Choose an eligible Discord channel for the public post.</p><a class="text-link" href="/tavern/peon-fight-club/">Visit Peon Fight Club</a></div></li>
    </ul>
  </section>
  <section class="wrap sc-callout" aria-labelledby="staff-tools"><div><h2 id="staff-tools">For guild leadership</h2><p>Staff tools follow configured roles and Discord permissions. Members can report incidents for staff review.</p></div><a class="button secondary" href="/admin-guide/">Guild administration</a></section>
</div>
<style>
  .cmd-console { display:grid; grid-template-columns:minmax(8.5rem,.45fr) minmax(0,1fr); background:#1c1d1c; }
  .cmd-console > label { grid-row:var(--row); grid-column:1; display:flex; align-items:center; gap:.55rem; min-height:2.48rem; padding:.45rem .65rem; border-left:3px solid transparent; font-size:.96rem; }
  .cmd-console > label svg { flex:none; color:#c2a27c; }
  .cmd-console > input:checked + label { border-left-color:var(--sc-ink); }
  .cmd-room { grid-column:2; grid-row:1 / span 8; border-left:1px solid var(--sc-line); background:#17191a; }
  .cmd-mast { position:relative; isolation:isolate; display:flex; justify-content:space-between; align-items:center; gap:.5rem; min-height:6.65rem; padding:1.1rem; background:#28231f; overflow:hidden; }
  .cmd-mast::before { content:''; position:absolute; inset:0; z-index:-1; background:linear-gradient(90deg,#262421fa,#25221ef0 52%,#1b1e1f96),url('../../../docs/assets/zugbot-fortress.webp') center 36%/cover; }
  .cmd-mast img {flex:none;}
  .cmd-mast .cmd-title { margin:.23rem 0 0; font:700 clamp(1.75rem,2.5vw,2.6rem)/.95 var(--display); }
  .cmd-records { list-style:none; padding:.35rem 1.15rem; margin:0; }
  .cmd-records li { display:flex; align-items:center; gap:.75rem; padding:.88rem 0; border-bottom:1px solid var(--sc-line); }
  .cmd-records li:last-child {border:0;}
  .cmd-records svg { flex:none;color:var(--sc-ink);}
  .cmd-records strong,.cmd-records span { display:block; }
  .cmd-records strong {font:600 1.16rem/1.15 var(--display);}
  .cmd-records span {margin-top:.15rem;font-size:.93rem;line-height:1.3;color:#c5c6c1;}
  @media (max-width:62rem) { .cmd-console {grid-template-columns:8.1rem minmax(0,1fr);} .cmd-mast img {width:40px;height:40px;} }
  @media (max-width:32rem) {
    .cmd-console {grid-template-columns:repeat(2,minmax(0,1fr));}
    .cmd-console > label {grid-row:auto;grid-column:auto;min-height:2.45rem;border-bottom:1px solid #393a38;}
    .cmd-room {grid-column:1/-1;grid-row:5;border-left:0;border-top:1px solid var(--sc-line);}
  }
</style>
